# Imports
from vital import *


# Environment
os_info = Fetch_OS()
cwd = os.path.abspath(os.getcwd())
env = Environment(tools=Fetch_Compiler(), PLATFORM="")
env.name = "vital.sdk"
env.Args = ARGUMENTS
env.Args["platform_type"] = env.Args.get("platform_type", "Server")
env.Args["build_type"] = env.Args.get("build_type", "Debug")


# Flags
env.Module.build()
env.MergeFlags(SConscript(".conan/SConscript_conandeps")["conandeps"])
env.Append(CPPDEFINES=["CPPHTTPLIB_OPENSSL_SUPPORT"])

if env.Args["platform_type"] == "Client":
    env.Append(CPPDEFINES=["VSDK_Client"])
if env.Args["build_type"] == "Debug":
    env.Append(CPPDEFINES=["VSDK_Debug"])

if os_info["type"] == "Windows":
    env.Append(CPPDEFINES=["VSDK_WINDOWS"])
    env.Append(CPPDEFINES=["_WIN32_WINNT=0x0A00", "WINVER=0x0A00", "WIN32_LEAN_AND_MEAN", "NOMINMAX"])
    env.Append(CPPFLAGS=["/EHsc", "/wd4244", "/bigobj"])
    env.Append(LIBS=["ws2_32", "winmm", "wbemuuid"])
    env.Append(LINKFLAGS=["/NODEFAULTLIB:LIBCMT", "/NODEFAULTLIB:LIBCMTD", "/NODEFAULTLIB:MSVCRTD"])
elif os_info["type"] == "Darwin":
    env.Append(CPPDEFINES=["VSDK_MACOS"])
    env.Append(CPPDEFINES=["LUA_USE_MACOSX", "DUK_F_APPLE", "HAS_SOCKLEN_T"])
elif os_info["type"] == "Linux":
    env.Append(CPPDEFINES=["VSDK_LINUX"])
    env.Append(CPPDEFINES=["LUA_USE_LINUX", "DUK_F_LINUX", "HAS_SOCKLEN_T"])
    env.Append(CXXFLAGS=["-fexceptions"])
    # godot-cpp defaults to disable_exceptions and appends -fno-exceptions after the
    # flag above, which silently wins — ask it to leave exceptions alone instead
    env.Args["disable_exceptions"] = "no"
    # rapidjson 1.1.0's GenericStringRef::operator= assigns to its const `length`
    # member. It is never instantiated, but GCC 14+ diagnoses it in the template body
    env.Append(CXXFLAGS=["-Wno-template-body"])


# Sandbox
env = SConscript("Vendor/godot-cpp/SConstruct", {"env": env.Clone()})
vendor_exclude = [
    "Vendor/godot-cpp"
]
env.sources = (
    env.RGlob("Tool", "*.cpp") +
    env.RGlob("Sandbox", "*.cpp") +
    env.RGlob("Engine", "*.cpp") +
    env.RGlob("Manager", "*.cpp") +
    env.RGlob("System", "*.cpp") +
    env.RGlob("Vendor", "*.cpp", exclude=vendor_exclude) +
    env.RGlob("Vendor", "*.c",   exclude=vendor_exclude) +
    env.RGlob("Vendor", "*.cc",  exclude=vendor_exclude)
)
env.Append(CPPPATH=[
    cwd,
    os.path.join(cwd, ".."),
    os.path.join(cwd, "Tool"),
    os.path.join(cwd, "Sandbox"),
    os.path.join(cwd, "Engine"),
    os.path.join(cwd, "Manager"),
    os.path.join(cwd, "System"),
    os.path.join(cwd, "Vendor"),
    os.path.join(cwd, "Vendor/lua"),
    os.path.join(cwd, "Vendor/discord-sdk")
])

if os_info["type"] == "Windows":
    env["LINKFLAGS"].remove("/WX")
    env.Append(LINKFLAGS=["/WX:NO", "/ignore:4099"])


# Build
platform = env["platform"]
suffix = env["suffix"].replace(".dev","").replace(".universal","").replace(f".{platform}","").replace("template_","")
bin_dir = f".bin/{env.Args['platform_type'].lower()}/{platform}"
build_dir = f".build/{env.Args['platform_type'].lower()}/{platform}"
bin_out = f"{bin_dir}/{env.name}{suffix}{env.subst('$SHLIBSUFFIX')}"
shutil.rmtree(bin_dir, ignore_errors=True)
# SCons prefixes shared libraries with "lib" on Linux/macOS, but vital.sdk.gdextension
# and build.py both expect the unprefixed name that Windows produces
if os_info["type"] != "Windows":
    env["SHLIBPREFIX"] = ""
bin = env.SharedLibrary(bin_out, source=env.sources)
build = env.Install(build_dir, bin)
env.Module.stage(build)
Default([bin, build])