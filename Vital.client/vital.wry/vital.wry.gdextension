[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.1"


[libraries]
windows.x86_64.debug = "./windows/vital.wry.debug.x86_64.dll"
windows.x86_64.release = "./windows/vital.wry.release.x86_64.dll"
linux.x86_64.debug = "./linux/vital.wry.debug.x86_64.so"
linux.x86_64.release = "./linux/vital.wry.release.x86_64.so"
macos.debug = "./macos/vital.wry.debug.dylib"
macos.release = "./macos/vital.wry.release.dylib"
